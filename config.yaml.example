server:
  host: "0.0.0.0"
  port: 18980

monitor:
  directories:
    - "~/Downloads"

database:
  path: "data/recruitment.db"

logging:
  level: "INFO"
  retention_days: 7
  path: "logs/app.log"

ocr:
  preprocess_enabled: true
  threshold: 128

report:
  company_name: "游戏公司"

llm:
  api_key_env: "DEEPSEEK_API_KEY"
  base_url: "https://api.deepseek.com/v1"
  model: "deepseek-chat"

positions:
  - name: "国内游戏广告创意策划"
    aliases: ["广告创意策划", "游戏广告创意"]
    jd_path: ""
    reference_dir: "references/国内游戏广告创意策划/"
    dimensions:
      - { name: "技能匹配", weight: 0.3 }
      - { name: "经验匹配", weight: 0.3 }
      - { name: "学历匹配", weight: 0.1 }
      - { name: "综合评价", weight: 0.3 }
    must_have:
      - "3年以上游戏广告创意/策划工作经验"
      - "熟悉真人广告拍摄流程"
      - "具备独立完成广告创意的能力"
      - "有AI广告制作经验"
    nice_to_have:
      - "有成功出圈的广告案例"
      - "熟悉多种广告投放平台"
    education: "本科及以上学历，广告、市场营销、传媒相关专业优先"
    experience: "3年以上"
    other_requirements: ""
    scoring:
      skill_match: "考察广告创意能力、策划能力、AI工具使用能力"
      experience_match: "考察游戏行业广告经验、项目经验"
      education_match: "考察学历与专业匹配度"
      overall: "综合评估创意能力、项目经验与岗位匹配度"

  - name: "Playable试玩广告开发工程师"
    aliases: ["Playable", "试玩广告"]
    jd_path: ""
    reference_dir: "references/Playable试玩广告开发工程师/"
    dimensions:
      - { name: "技术能力", weight: 0.4 }
      - { name: "游戏开发经验", weight: 0.3 }
      - { name: "学历匹配", weight: 0.1 }
      - { name: "综合评价", weight: 0.2 }
    must_have:
      - "熟练使用Cocos Creator"
      - "熟悉TypeScript/JavaScript"
      - "有游戏行业开发经验"
    nice_to_have:
      - "有Playable广告制作经验"
      - "了解广告投放逻辑"
    education: "本科及以上学历，计算机相关专业优先"
    experience: "2年以上"
    other_requirements: ""
    scoring:
      skill_match: "考察Cocos Creator、TypeScript等技术能力"
      experience_match: "考察游戏开发经验和Playable广告经验"
      education_match: "考察学历与专业匹配度"
      overall: "综合评估技术能力与行业经验"

  - name: "游戏AI广告设计师"
    aliases: ["AI广告设计", "游戏广告设计"]
    jd_path: ""
    reference_dir: "references/游戏AI广告设计师/"
    dimensions:
      - { name: "设计能力", weight: 0.3 }
      - { name: "AI工具使用", weight: 0.3 }
      - { name: "经验匹配", weight: 0.2 }
      - { name: "综合评价", weight: 0.2 }
    must_have:
      - "熟练使用AI设计工具（Midjourney/Stable Diffusion等）"
      - "3年以上游戏广告设计经验"
      - "具备独立完成广告素材设计的能力"
      - "对游戏视觉表现有深刻理解"
      - "熟悉游戏行业广告投放素材规范"
      - "有游戏广告投放素材制作经验"
    nice_to_have:
      - "有3D设计经验"
      - "有视频剪辑能力"
    education: "本科及以上学历，设计、视觉传达相关专业优先"
    experience: "3年以上"
    other_requirements: ""
    scoring:
      skill_match: "考察设计能力、AI工具使用熟练度"
      experience_match: "考察游戏广告设计经验"
      education_match: "考察学历与专业匹配度"
      overall: "综合评估设计能力、AI工具使用和行业经验"

  - name: "3D动作设计师"
    aliases: ["3D动作", "动作设计师"]
    jd_path: ""
    reference_dir: "references/3D动作设计师/"
    dimensions:
      - { name: "3D技能", weight: 0.35 }
      - { name: "经验匹配", weight: 0.35 }
      - { name: "学历匹配", weight: 0.1 }
      - { name: "综合评价", weight: 0.2 }
    must_have:
      - "熟练使用Maya/3ds Max等3D软件"
      - "3年以上3D动作设计经验"
      - "具备独立完成角色动作设计的能力"
      - "对游戏动作表现有深刻理解"
      - "熟悉骨骼绑定和蒙皮技术"
    nice_to_have:
      - "有Unreal Engine经验"
      - "熟悉Motion Capture流程"
      - "有次时代游戏项目经验"
    education: "本科及以上学历，动画、美术相关专业优先"
    experience: "3年以上"
    other_requirements: ""
    scoring:
      skill_match: "考察3D软件熟练度、动作设计能力"
      experience_match: "考察游戏行业动作设计经验"
      education_match: "考察学历与专业匹配度"
      overall: "综合评估3D技能、项目经验与岗位匹配度"

  - name: "游戏场景原画设计师"
    aliases: ["场景原画", "游戏原画", "原画设计师"]
    jd_path: ""
    reference_dir: "references/游戏场景原画设计师/"
    dimensions:
      - { name: "原画技能", weight: 0.35 }
      - { name: "经验匹配", weight: 0.35 }
      - { name: "学历匹配", weight: 0.1 }
      - { name: "综合评价", weight: 0.2 }
    must_have:
      - "熟练使用Blender进行3D辅助设计"
      - "3年以上游戏场景原画设计经验"
      - "具备独立完成场景概念设计的能力"
      - "对游戏场景视觉表现有深刻理解"
      - "精通Photoshop等绘图软件"
      - "有完整的游戏项目场景设计经验"
    nice_to_have:
      - "有Unreal Engine场景搭建经验"
      - "熟悉PBR材质流程"
      - "有次时代游戏项目经验"
    education: "本科及以上学历，美术、设计相关专业优先"
    experience: "3年以上"
    other_requirements: ""
    scoring:
      skill_match: "考察原画设计能力、Blender使用熟练度"
      experience_match: "考察游戏行业场景原画经验"
      education_match: "考察学历与专业匹配度"
      overall: "综合评估原画技能、项目经验与岗位匹配度"

  - name: "游戏服务器开发工程师"
    aliases: ["游戏服务器", "服务器开发", "游戏后端"]
    jd_path: ""
    reference_dir: "references/游戏服务器开发工程师/"
    dimensions:
      - { name: "技术能力", weight: 0.35 }
      - { name: "游戏后端经验", weight: 0.35 }
      - { name: "学历匹配", weight: 0.1 }
      - { name: "综合评价", weight: 0.2 }
    must_have:
      - "熟练使用C++/Go/Java至少一种"
      - "3年以上游戏服务器开发经验"
      - "熟悉网络编程和并发编程"
      - "有高并发系统设计经验"
      - "熟悉至少一种数据库（MySQL/Redis/MongoDB）"
    nice_to_have:
      - "有微服务架构经验"
      - "熟悉容器化部署（Docker/K8s）"
      - "有千万DAU游戏项目经验"
    education: "本科及以上学历，计算机相关专业优先"
    experience: "3年以上"
    other_requirements: ""
    scoring:
      skill_match: "考察编程能力、系统设计能力"
      experience_match: "考察游戏服务器开发经验"
      education_match: "考察学历与专业匹配度"
      overall: "综合评估技术能力与游戏行业经验"

portfolio_domains:
  - "artstation.com"
  - "github.com"
  - "behance.net"
  - "zcool.com.cn"
  - "gitee.com"
  - "notion.so"
  - "figma.com"
  - "dribbble.com"
